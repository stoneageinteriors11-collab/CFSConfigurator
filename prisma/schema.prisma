// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A shopper's basket. The shopper holds a secret token; only its hash is stored here.
// Version goes up on every change, so a checkout can be tied to one exact basket state.
model Basket {
  id        String       @id @default(uuid())
  shop      String
  tokenHash String
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lines     BasketLine[]
  attempts  CheckoutAttempt[]

  @@unique([shop, tokenHash])
}

// One item in a basket. An ordinary product is a line with an empty selection.
// configurationKey identifies the variant and its choices: identical copies share one
// line and use quantity, while different configurations of a variant stay separate.
model BasketLine {
  id               String   @id @default(uuid())
  basketId         String
  basket           Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  configurationKey String
  productId        String
  variantId        String
  sku              String
  title            String   @default("")
  variantTitle     String   @default("")
  handle           String   @default("")
  imageUrl         String?
  quantity         Int
  baseCents        Int
  unitCents        Int
  selection        Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([basketId, configurationKey])
}

// One checkout for one exact basket version, saved before Shopify is called, so repeat
// clicks reuse it. Kept when its basket is deleted, because a paid order still needs it.
// lines and totalCents record what was priced, since the basket can change afterwards.
// status is creating, ready or failed; ready requires the draft order and its checkout link.
model CheckoutAttempt {
  id            String   @id @default(uuid())
  shop          String
  basketId      String?
  basket        Basket?  @relation(fields: [basketId], references: [id], onDelete: SetNull)
  basketVersion Int
  status        String   @default("creating")
  lines         Json
  totalCents    Int
  draftOrderId  String?  @unique
  invoiceUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  snapshot      OrderSnapshot?

  @@unique([basketId, basketVersion])
}

// The permanent record of one Shopify order, for staff and fulfilment. One per order, however
// often Shopify repeats the webhook. A database trigger refuses any change to specification,
// so later catalogue edits cannot alter an old order. financialStatus and cancelledAt follow
// Shopify. matchStatus is matched, no_attempt (not from an app checkout) or price_mismatch.
model OrderSnapshot {
  id              String           @id @default(uuid())
  shop            String
  orderId         String
  orderName       String
  attemptId       String?          @unique
  attempt         CheckoutAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  matchStatus     String
  specification   Json
  financialStatus String
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([shop, orderId])
}

// How far the catch-up on missed order notifications has got, per shop.
model OrderRecovery {
  shop         String   @id
  checkedUntil DateTime
  updatedAt    DateTime @updatedAt
}
